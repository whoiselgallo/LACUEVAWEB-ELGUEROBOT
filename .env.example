# ═════════════════════════════════════════════════════════════════════════════════
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example) - LA CUEVA DEL GÜERO
# ═════════════════════════════════════════════════════════════════════════════════

# --- ENTORNO Y APLICACIÓN ---
APP_ENV=production
APP_DEBUG=false
APP_NAME="La Cueva del Güero"
APP_VERSION=2.5.0
APP_URL=https://lacuevadelguero.com

# --- CREDENCIALES MAESTRAS DEL DASHBOARD ---
ADMIN_USER=admin
ADMIN_EMAIL=admin@lacuevadelguero.com
ADMIN_PASS=Cueva2026!

# --- BASE DE DATOS (POSTGRESQL - NEON / CLOUD SQL) ---
DB_HOST=ep-winter-queen-af6tc66y-pooler.c-2.us-west-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=tu_password_de_base_de_datos

# --- DIFY AI INTEGRATION ---
DIFY_CHATBOT_API_KEY=tu_dify_chatbot_api_key
DIFY_CHATBOT_URL=https://api.dify.ai/v1/chat-messages
DIFY_WORKFLOW_API_KEY=tu_dify_workflow_api_key
DIFY_WORKFLOW_URL=https://api.dify.ai/v1/workflows/run
DIFY_TIMEOUT=60

# --- GOOGLE AI STUDIO / GEMINI (ROTACIÓN MULTI-CLAVE) ---
GEMINI_API_KEY=tu_gemini_api_key
GEMINI_API_KEYS=clave1,clave2,clave3

# --- GOOGLE OAUTH (DRIVE, YOUTUBE & CLOUD PICKER) ---
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# --- DEPLOY & VERCEL ---
VERCEL_TOKEN=tu_vercel_token
