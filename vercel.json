{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    },
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/favicon.png",
      "dest": "/favicon.png"
    },
    {
      "src": "/api/api-el-guero-bot\\.php",
      "dest": "/api/guero-bot.js"
    },
    {
      "src": "/api/api-el-guero-bot",
      "dest": "/api/guero-bot.js"
    },
    {
      "src": "/api/api-escaleta(\\.php)?",
      "dest": "/api/ai-escaleta.js"
    },
    {
      "src": "/api/api-hooks-ai(\\.php)?",
      "dest": "/api/ai-hooks.js"
    },
    {
      "src": "/api/api-guero-knowledge(\\.php)?",
      "dest": "/api/guero-knowledge.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "s.lacuevadelguero.com"
        }
      ],
      "src": "/(.*)",
      "dest": "/tracking/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "admin.lacuevadelguero.com"
        }
      ],
      "src": "/(.*)",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/tracking",
      "dest": "/tracking/index.html"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/dashboard/$1"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
