{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "has": [
        {
          "type": "host",
          "value": "admin.lacuevadelguero.com"
        }
      ],
      "src": "/(.*)",
      "dest": "/api/index.php"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "s.lacuevadelguero.com"
        }
      ],
      "src": "/(.*)",
      "dest": "/tracking/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/tracking",
      "dest": "/tracking/index.html"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/dashboard",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
