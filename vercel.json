{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "admin.lacuevadelguero.com"
        }
      ],
      "src": "/login",
      "dest": "/api/login.php"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "admin.lacuevadelguero.com"
        }
      ],
      "src": "/logout",
      "dest": "/api/logout.php"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "admin.lacuevadelguero.com"
        }
      ],
      "src": "/(.*)",
      "dest": "/api/dashboard.php"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "s.lacuevadelguero.com"
        }
      ],
      "src": "/(.*)",
      "dest": "/tracking/index.html"
    },
    {
      "src": "/tracking",
      "dest": "/tracking/index.html"
    },
    {
      "src": "/dashboard/login",
      "dest": "/api/login.php"
    },
    {
      "src": "/dashboard/logout",
      "dest": "/api/logout.php"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/api/dashboard.php"
    },
    {
      "src": "/dashboard",
      "dest": "/api/dashboard.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
